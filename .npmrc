# Les scripts d'installation des paquets ne s'exécutent jamais, ni en CI ni sur
# un poste de développement : c'est par eux que se propagent les paquets npm
# compromis. Aucune dépendance du projet n'en a besoin — celui d'esbuild n'est
# qu'une optimisation. `npm test` et `npm run build` ne sont pas concernés.
ignore-scripts=true
